# Local dev database from `npm run db`
DATABASE_URL=postgres://postgres:postgres@localhost:54320/openshelf
ORIGIN=http://localhost:5173

# Google OAuth client. Authorised redirect URI: ${ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated Google emails with /admin access
ADMIN_EMAILS=

# Unset: notifications are logged instead of emailed
RESEND_API_KEY=
RESEND_FROM=OpenShelf <hello@example.com>

# Dev only: enables /dev-login. Has no effect in a production build.
DEV_LOGIN=1

# Unset: payments and courier run in test mode, labelled in the UI. No money moves.
# A production build refuses to start in test mode unless ALLOW_TEST_PAYMENTS=1.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
ALLOW_TEST_PAYMENTS=

# Required in production. Salts the hash that keeps a ban on a deleted account.
SUB_HASH_SALT=
