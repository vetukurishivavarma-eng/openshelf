{
  "name": "openshelf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db": "node scripts/db.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "postgres": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "embedded-postgres": "^18.6.0-beta.19",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
